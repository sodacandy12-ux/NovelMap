# API 키는 화면 상단 설정 바에서 입력하는 것을 권장한다(서버 메모리에만 보관, 재시작 시 다시 입력).
# 환경 변수에 키가 있으면 입력 없이 그 값을 기본으로 쓴다. 이 파일은 .gitignore에 있다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# 병렬 LLM 호출 수(기본: Anthropic 8, 그 외 2)
LLM_CONCURRENCY=
# 임베딩은 로컬 bge-m3(기본). 테스트용으로 해시 임베딩을 쓰려면 EMBEDDING=hash
EMBEDDING=
# Neo4j(선택): 관계 경로 찾기·GraphRAG에 사용. 비워 두면 JSON 모드로 동작한다. 설정 바에는 넣지 않고 로그·Git에도 남기지 않는다.
# 예) docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/<비밀번호> neo4j
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
